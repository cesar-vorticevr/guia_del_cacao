# Supabase local (los valores reales los imprime `npx supabase start`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URL publica del sitio. En produccion es obligatoria: detras de un proxy la
# cabecera host no es el dominio real y la vuelta de Google saldria mal.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Entrar con Google
# ---------------------------------------------------------------------------
# Las dos salen de Google Cloud Console > APIs y servicios > Credenciales, del
# "ID de cliente de OAuth 2.0" del proyecto.
#
# Las lee `supabase/config.toml`, no la aplicacion: sirven para que el Supabase
# LOCAL sepa hablar con Google. En produccion las credenciales ya viven en el
# dashboard de Supabase, asi que estas dos no hacen falta en Vercel.
#
# En Google Cloud, ese mismo cliente necesita autorizados los dos retornos:
#   http://127.0.0.1:54421/auth/v1/callback   (Supabase local)
#   https://xhavrblxdjvwffsmblmg.supabase.co/auth/v1/callback   (produccion)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
